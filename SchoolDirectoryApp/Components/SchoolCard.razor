@* A small reusable box that shows ONE school in the list *@

<div class="card mb-2 @(IsSelected ? "border-primary border-2" : "")"
     style="cursor: pointer;"
     @onclick="() => OnSelect.InvokeAsync(School)">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title">@School.SchoolName</h5>

            @* Star button to make it favorite *@
            <button class="btn btn-sm @(IsFavourite ? "btn-warning" : "btn-outline-warning")"
                    @onclick="() => OnToggleFavourite.InvokeAsync(School)"
                    @onclick:stopPropagation="true">
                @(IsFavourite ? "★" : "☆")
            </button>
        </div>

        <p class="mb-1"><strong>ID:</strong> @School.SchoolId</p>
        <p class="mb-1"><strong>Address:</strong> @School.Address</p>
        <p class="mb-1"><strong>Phone:</strong> @School.PhoneNo</p>
        <p class="mb-1"><strong>Email:</strong> @School.EmailAddress</p>
        <p class="mb-1"><strong>Proprietor:</strong> @School.ProprietorFullName</p>
        <p class="mb-0"><strong>Head:</strong> @School.HeadFullName</p>
    </div>
</div>

@code {
    // The school to show
    [Parameter]
    public School School { get; set; } = new();

    // if this card is the one currently selected gives it a blue border
    [Parameter]
    public bool IsSelected { get; set; }

    // if the school is in the user's favourites fills in the star
    [Parameter]
    public bool IsFavourite { get; set; }

    // Tells the page the card was clicked
    [Parameter]
    public EventCallback<School> OnSelect { get; set; }

    // Tells the page the star was clicked
    [Parameter]
    public EventCallback<School> OnToggleFavourite { get; set; }
}