@page "/"
@inject SchoolService Service
@inject FavouritesService Favourites

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="text-muted mb-0">Overview of the schools from the Edutots School API.</p>
    </div>
    <a href="schools" class="btn btn-primary">Browse schools</a>
</div>

@if (error)
{
    <div class="alert alert-danger" role="alert">
        Unable to retrieve school data.
    </div>
}
else if (schools == null)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
        Loading schools...
    </div>
}
else
{
    @* geting data for the chart *@
    <div class="row g-3 mb-3">
        <div class="col-md-3 col-6">
            <div class="card panel stat-card">
                <div class="card-body">
                    <div class="stat-label">Total schools</div>
                    <div class="stat-value">@schools.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card panel stat-card green">
                <div class="card-body">
                    <div class="stat-label">With email</div>
                    <div class="stat-value">@CountFilled(s => s.EmailAddress)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card panel stat-card">
                <div class="card-body">
                    <div class="stat-label">Proprietors</div>
                    <div class="stat-value">@ProprietorCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card panel stat-card amber">
                <div class="card-body">
                    <div class="stat-label">Favourites</div>
                    <div class="stat-value">@Favourites.Count</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">

        @* Bar chart *@
        <div class="col-lg-7">
            <div class="card panel h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Data completeness</h6>

                    @foreach (var item in Completeness)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small">
                                <span>@item.Label</span>
                                <span class="text-muted">@item.Count of @schools.Count</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" style="width: @(Percent(item.Count))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Favourite schools *@
        <div class="col-lg-5">
            <div class="card panel h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Your favourites</h6>

                    @if (!FavouriteSchools.Any())
                    {
                        <p class="text-muted small mb-0">
                            Nothing here yet. Star a school on the
                            <a href="schools">Schools page</a> and it will show up here.
                        </p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var school in FavouriteSchools)
                            {
                                <li class="list-group-item px-0">
                                    <div class="fw-semibold">@school.SchoolName</div>
                                    <small class="text-muted">@school.HeadFullName</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

    </div>
}

@code {
    private List<School>? schools;   // null = still loading
    private bool error;              // if the API failed

    // How many schools have something filled in for the chosen field
    private int CountFilled(Func<School, string> field)
    {
        return schools!.Count(s => !string.IsNullOrWhiteSpace(field(s)));
    }

    // Turns a count into a percentage of all schools
    private int Percent(int count)
    {
        return schools!.Count == 0 ? 0 : count * 100 / schools.Count;
    }

    private IEnumerable<(string Label, int Count)> Completeness => new[]
    {
        ("Email address", CountFilled(s => s.EmailAddress)),
        ("Phone number", CountFilled(s => s.PhoneNo)),
        ("Address", CountFilled(s => s.Address)),
        ("Head named", CountFilled(s => s.HeadFullName)),
        ("Proprietor named", CountFilled(s => s.ProprietorFullName))
    };

    // counts how many different proprietors there are
    private int ProprietorCount =>
        schools!.Select(s => s.ProprietorFullName)
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

    // shows the favorites schools
    private IEnumerable<School> FavouriteSchools =>
        schools!.Where(s => Favourites.IsFavourite(s.SchoolId));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schools = await Service.GetSchoolsAsync();
        }
        catch
        {
            error = true;
        }
    }
}